# Use c++20
build --cxxopt=-std=c++20 --host_cxxopt=-std=c++20

# Forces the use of a minimal, predefined environment.
build --incompatible_strict_action_env

# Disable "auto-discovery" of local C++ toolchains.
build --incompatible_enable_cc_toolchain_resolution

# Run build actions in an isolated filesystem sandbox.
build --spawn_strategy=sandboxed

# Provide a clean, empty /tmp directory for every action.
build --sandbox_tmpfs_path=/tmp

# Guarantee all dependencies are pre-fetched and not downloaded mid-build.
build --sandbox_default_allow_network=false
