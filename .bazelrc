# Enable Bzlmod for every Bazel command
common --enable_bzlmod

common --registry=https://bcr.bazel.build/
common --registry=https://raw.githubusercontent.com/google-parfait/confidential-federated-compute/main/registry

# Use c++20
build --cxxopt=-std=c++20 --host_cxxopt=-std=c++20

# Forces the use of a minimal, predefined environment.
build --incompatible_strict_action_env

# Disable "auto-discovery" of local C++ toolchains.
build --incompatible_enable_cc_toolchain_resolution

# Run build actions in an isolated filesystem sandbox.
build --spawn_strategy=sandboxed
build --strategy=CopyFile=sandboxed,standalone
build --strategy=CopyToDirectory=sandboxed,standalone

# Provide a clean, empty /tmp directory for every action.
build --sandbox_tmpfs_path=/tmp

# Guarantee all dependencies are pre-fetched and not downloaded mid-build.
build --sandbox_default_allow_network=false

# Run test actions in an isolated filesystem sandbox.
test --spawn_strategy=sandboxed
test --strategy=CopyToDirectory=local

# Disable layering check to bypass errors in external dependencies.
build --features=-layering_check

# Stamping configuration
build --workspace_status_command=tools/workspace_status.sh
