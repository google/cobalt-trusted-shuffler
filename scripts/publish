# Writes a binary and its GitHub attestation bundle to the Oak discoverability
# buckets (oak-files and oak-index) and updates indexes 6, 7, and 12. Index 12
# is only written when GITHUB_REF is refs/heads/main so non-main runs cannot
# claim a reproducible binary digest under --no-clobber.
# Adapted from https://github.com/project-oak/oak/blob/main/scripts/publish.

set -o errexit
set -o nounset
set -o pipefail

readonly FBUCKET=oak-files
readonly IBUCKET=oak-index

# Index IDs in oak-index:
#   6: (commit hash, package name) -> binary SHA2-256 digest
#   7: (commit hash, package name) -> provenance SHA2-256 digest
#  12: binary SHA2-256 digest -> provenance SHA2-256 digest
readonly BINARY_FOR_COMMIT=6
readonly PROV_FOR_COMMIT=7
readonly PROV_FOR_BINARY=12

TMP_DIR=""
cleanup() {
  if [[ -n "${TMP_DIR}" ]]; then
    rm -rf -- "${TMP_DIR}"
  fi
}
trap cleanup EXIT

usage_and_exit() {
  >&2 echo "Usage: $0 <binary_path> <prov_path> sha1:<commit_hash> <package_name>"
  exit 1
}

# Redirect stdout to stderr so upload_file only emits the content digest.
copy_file() {
  gcloud storage cp --no-clobber "$1" "$2" >&2
}

# Uploads a file to the content-addressed file bucket and returns its SHA2-256 hash.
upload_file() {
  local file="$1"
  local hash
  hash="sha2-256:$(sha256sum "${file}" | cut -d " " -f 1)"
  copy_file "${file}" "gs://${FBUCKET}/${hash}"

  # static.space maintains a long-term map from file hash to public URL.
  # Best effort only so transient snapshot errors do not block releases.
  local url="https://storage.googleapis.com/${FBUCKET}/${hash}"
  curl --fail --request POST \
    --header 'Content-Type: application/json' \
    --data "{ \"url\": \"${url}\" }" \
    --retry 3 \
    --retry-delay 2 \
    --retry-all-errors \
    https://api.static.space/v1/snapshot >/dev/null || true

  echo "${hash}"
}

publish() {
  local binary_path="$1"
  local provenance_path="$2"
  local commit_hash="$3"
  local package_name="$4"

  TMP_DIR="$(mktemp -d)"
  local bhash_path="${TMP_DIR}/bhash"
  local phash_path="${TMP_DIR}/phash"
  upload_file "${binary_path}" >"${bhash_path}"
  upload_file "${provenance_path}" >"${phash_path}"
  local bhash
  bhash="$(cat "${bhash_path}")"

  copy_file \
    "${bhash_path}" \
    "gs://${IBUCKET}/${BINARY_FOR_COMMIT}/${commit_hash}/${package_name}"
  copy_file \
    "${phash_path}" \
    "gs://${IBUCKET}/${PROV_FOR_COMMIT}/${commit_hash}/${package_name}"
  # Only main builds may claim the binary-digest index (12) under --no-clobber.
  if [[ "${GITHUB_REF:-}" == "refs/heads/main" ]]; then
    copy_file \
      "${phash_path}" \
      "gs://${IBUCKET}/${PROV_FOR_BINARY}/${bhash}"
  fi
}

if [[ $# != 4 ]]; then
  usage_and_exit
fi

set -o xtrace
publish "$1" "$2" "$3" "$4"
