module(
    name = "trusted-shuffler",
    repo_name = "com_google_cobalt_trusted_shuffler",
)

bazel_dep(name = "abseil-cpp", version = "20250814.1")
bazel_dep(name = "confidential-federated-compute", version = "0.0.12")
bazel_dep(name = "googletest", version = "1.17.0")
bazel_dep(name = "grpc", version = "1.76.0")
bazel_dep(name = "boringssl", version = "0.20250514.0")
bazel_dep(name = "protobuf", version = "33.4")
bazel_dep(name = "rules_cc", version = "0.2.16")
bazel_dep(name = "toolchains_llvm", version = "1.4.0")
bazel_dep(name = "rules_oci", version = "2.2.6")
bazel_dep(name = "rules_pkg", version = "1.1.0")
bazel_dep(name = "rules_python", version = "1.6.0")

cfc_deps = use_extension("@confidential-federated-compute//:extensions.bzl", "cfc_deps")
use_repo(cfc_deps, "federated-compute", "oak")

stub_tf_proto_library = use_repo_rule("@confidential-federated-compute//:stub_tf_proto_library.bzl", "stub_tf_proto_library")
stub_tf_proto_library(
    name = "org_tensorflow",
)

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "distroless_cc_debian12",
    digest = "sha256:6714977f9f02632c31377650c15d89a7efaebf43bab0f37c712c30fc01edb973",
    image = "gcr.io/distroless/cc-debian12",
    platforms = ["linux/amd64"],
)
use_repo(oci, "distroless_cc_debian12", "distroless_cc_debian12_linux_amd64")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# Set up the cc toolchain using CFC's sysroot.
http_archive(
    name = "sysroot",
    sha256 = "f58c289b3ccb28895ad8ca408ac366e709037088e8b5c28aca18212adc18c31e",
    url = "https://github.com/google-parfait/confidential-federated-compute/releases/download/sysroot-20250618/sysroot.tar.xz",
)

http_archive(
    name = "pymsh",
    build_file_content = """load("@rules_python//python:defs.bzl", "py_library")

py_library(
    name = "pymsh",
    srcs = ["pymsh.py"],
    visibility = ["//visibility:public"],
)
""",
    sha256 = "7bfccae7785f0344637ccf65eadbb0e4bbf844f3de1e5a2d384e6d6ff82bcf68",
    type = "zip",
    urls = ["https://files.pythonhosted.org/packages/4e/37/9a770747cb05b5aa4c062ce7c0069635943cd72d734b5db980253921adc6/pymsh-1.2.3-py3-none-any.whl"],
)

http_archive(
    name = "org_tensorflow_federated",
    integrity = "sha256-LRtgjagA16SepVffwpMCh8zfT60rzGSYRekKAGaQ2ss=",
    patch_args = ["-p1"],
    patches = ["//third_party/org_tensorflow_federated:tff.patch"],
    strip_prefix = "tensorflow-federated-590104cb7c358ee5c4efa8937e0ccf93a5925265",
    url = "https://github.com/google-parfait/tensorflow-federated/archive/590104cb7c358ee5c4efa8937e0ccf93a5925265.tar.gz",
)

# Allow non-hermetic builds when building in downstream projects inheriting this module.
llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm", dev_dependency = True)
llvm.toolchain(
    name = "llvm_toolchain",
    llvm_version = "19.1.0",
    stdlib = {"linux-x86_64": "stdc++"},
)
llvm.sysroot(
    name = "llvm_toolchain",
    label = "@sysroot",
    targets = ["linux-x86_64"],
)
use_repo(llvm, "llvm_toolchain")

register_toolchains("@llvm_toolchain//:all")

bazel_dep(name = "hedron_compile_commands", dev_dependency = True)
git_override(
    module_name = "hedron_compile_commands",
    commit = "abb61a688167623088f8768cc9264798df6a9d10",
    remote = "https://github.com/hedronvision/bazel-compile-commands-extractor.git",
)
